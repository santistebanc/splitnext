{
  "name": "splitnext-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && npm run frontend:build && wrangler dev --port 8787 --var ENABLE_DEBUG_INSPECTION:true",
    "deploy": "npm run frontend:build && wrangler deploy",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "db:migrate:local": "wrangler d1 migrations apply INDEX --local",
    "db:migrate:remote": "wrangler d1 migrations apply INDEX --remote",
    "frontend:build": "npm run app:build && node scripts/prepare-app.mjs",
    "app:dev": "npm run dev --workspace @splitnext/app",
    "app:build": "npm run build --workspace @splitnext/app",
    "app:typecheck": "npm run typecheck --workspace @splitnext/app",
    "lint": "oxlint --type-aware .",
    "frontend:check": "npm run frontend:build && node --check .wrangler/app-assets/service-worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check:fast": "node scripts/check-text.mjs && npm run types:check && npm run lint && npm run typecheck && npm run app:typecheck && wrangler deploy --dry-run --outdir .wrangler/dry-run && npm test",
    "check": "npm run frontend:check && npm run check:fast && npm run test:e2e",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.1",
    "expo-server": "~57.0.3",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  }
}

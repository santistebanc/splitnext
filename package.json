{
  "name": "splitnext-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "decode-uri-component": "0.5.1",
    "minimatch": "11.0.8"
  },
  "scripts": {
    "dev": "node scripts/check-dev-port.mjs && npm run db:migrate:local && npm run frontend:build && wrangler dev --port 8787 --var ENABLE_DEBUG_INSPECTION:true",
    "deploy": "npm run frontend:build && wrangler deploy",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "db:migrate:local": "wrangler d1 migrations apply INDEX --local",
    "db:migrate:remote": "wrangler d1 migrations apply INDEX --remote",
    "frontend:build": "node scripts/verify.mjs build",
    "app:dev": "npm run dev --workspace @splitnext/app",
    "app:build": "npm run build --workspace @splitnext/app",
    "app:typecheck": "npm run typecheck --workspace @splitnext/app",
    "lint": "oxlint --type-aware .",
    "frontend:check": "npm run frontend:build && node --check .wrangler/app-assets/service-worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:steady": "playwright test --grep-invert @timing",
    "test:e2e:timing": "playwright test --grep @timing",
    "showcase": "npm run frontend:build && node showcase/build.mjs clean && playwright test -c showcase/playwright.config.ts && node showcase/build.mjs",
    "showcase:page": "node showcase/build.mjs",
    "check:fast": "npm run check:fast:steady && npm run test:performance",
    "check:fast:steady": "node scripts/check-text.mjs && npm run verify:check && npm run types:check && npm run lint && npm run typecheck && npm run app:typecheck && wrangler deploy --dry-run --outdir .wrangler/dry-run && npm run lab:test && npm test",
    "check": "npm run frontend:check && npm run check:fast && npm run test:e2e",
    "check:steady": "npm run frontend:check && npm run check:fast:steady && npm run test:e2e:steady",
    "check:timing": "npm run test:performance && npm run test:e2e:timing",
    "prepare": "node scripts/install-hooks.mjs",
    "lab": "node lab/server.mjs",
    "lab:cli": "node lab/cli.mjs",
    "lab:test": "node --test lab/test.mjs",
    "lab:acceptance": "node lab/acceptance.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:check": "node --test verification/*.test.mjs && node scripts/verify.mjs check",
    "test:performance": "vitest run -c vitest.performance.config.ts",
    "verify:expense-recovery": "node scripts/verify.mjs run expense-recovery"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "motion": "^14.7.1",
    "motion-panels": "^0.6.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.1",
    "expo-server": "~57.0.3",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  }
}

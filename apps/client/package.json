{
  "name": "@splitnext/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sqlite"
        ]
      }
    }
  },
  "scripts": {
    "dev": "EXPO_PUBLIC_API_URL=http://localhost:8787 expo start --web --port 8081",
    "build": "node ../../scripts/brand-assets.mjs --check && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "native:dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:bundle": "expo export --platform android --platform ios --output-dir native-dist --source-maps"
  },
  "dependencies": {
    "@splitnext/client": "*",
    "base64-js": "^1.5.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-server": "~58.1.0",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-number-format": "^5.4.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0"
  }
}

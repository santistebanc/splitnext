{
  "name": "@splitnext/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-sqlite"]
      }
    }
  },
  "scripts": {
    "dev": "EXPO_PUBLIC_API_URL=http://localhost:8787 expo start --web --port 8081",
    "build": "node ../../scripts/brand-assets.mjs --check && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "native:dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:bundle": "expo export --platform android --platform ios --output-dir native-dist --source-maps"
  },
  "dependencies": {
    "@splitnext/client": "*",
    "base64-js": "^1.5.1",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-server": "~57.0.3",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.4",
    "react-number-format": "^5.4.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0"
  }
}

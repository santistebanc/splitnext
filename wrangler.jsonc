{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitnext-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "find_additional_modules": true,
  "rules": [
    { "type": "CommonJS", "globs": ["generated/expo-server/**/*.js"], "fallthrough": false },
    { "type": "Text", "globs": ["generated/expo-server/**/*.json"], "fallthrough": false }
  ],
  "workers_dev": true,
  // Keep the request log lines and uncaught errors in Workers Logs.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./.wrangler/app-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/privacy", "/terms", "/app", "/app/*", "/j", "/j/", "/join/*"]
  },
  "vars": {
    "DEPLOY_SHA": "local",
    "ENABLE_DEBUG_INSPECTION": "false",
    "LOG_REQUESTS": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUPS",
        "class_name": "GroupObject"
      }
    ]
  },
  "exports": {
    "GroupObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "splitnext-v4-index",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // A separate deployment for trying releases before production: its own
  // Worker (splitnext-api-staging), database and group storage.
  "env": {
    "staging": {
      "vars": {
        "DEPLOY_SHA": "local",
        "ENABLE_DEBUG_INSPECTION": "false",
        "LOG_REQUESTS": "true"
      },
      "durable_objects": {
        "bindings": [{ "name": "GROUPS", "class_name": "GroupObject" }]
      },
      "d1_databases": [
        {
          "binding": "INDEX",
          "database_name": "splitnext-staging-index",
          "database_id": "f3336d8b-adf2-438f-b1df-37bad9112484",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
